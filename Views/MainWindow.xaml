<Window x:Class="CertView.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CertView.Views"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Margin="10,0,1,0">
            <TextBox TextWrapping="Wrap" Text="{Binding FilePath, Mode=TwoWay}" Width="120" Margin="0,24,0,0" HorizontalAlignment="Center"/>
            <Button Content="Browse" HorizontalAlignment="Center" Margin="0,12,0,0" Click="Browse_Click"/>
            <Button HorizontalAlignment="Center" Margin="0,6,0,0" Content="Open" Click="Open_Click"/>
        </StackPanel>
    </Grid>

</Window>
